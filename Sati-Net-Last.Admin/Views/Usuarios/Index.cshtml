@model IEnumerable<UsuarioBroker>

@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Gestión de Clientes - Usuarios Broker</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Create", "Usuarios")" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nuevo Cliente
            </a>
        </div>
    </div>

    <!-- Mensaje de Alerta -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Usuarios -->
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre Completo</th>
                        <th>Correo</th>
                        <th>Par de Moneda</th>
                        <th>Estado</th>
                        <th>Fecha Registro</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.Id</td>
                            <td>@usuario.NombreCompleto</td>
                            <td>@usuario.Correo</td>
                            <td><span class="badge bg-info">@usuario.ParMoneda</span></td>
                            <td>
                                @if (usuario.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>@usuario.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-warning">Editar</a>
                                <a href="#" class="btn btn-sm btn-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Sin clientes registrados</h4>
            <p>No hay usuarios broker registrados. <a href="@Url.Action("Create", "Usuarios")">Crea el primer cliente aquí</a>.</p>
        </div>
    }
</div>
