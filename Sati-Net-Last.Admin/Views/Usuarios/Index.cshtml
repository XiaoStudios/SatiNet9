@model IEnumerable<UserSymbol>

@{
    ViewData["Title"] = "Gestión de Símbolos";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Gestión de Símbolos - Asignación a Usuarios</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Create", "Usuarios")" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Asignar Símbolo
            </a>
        </div>
    </div>

    <!-- Mensaje de Alerta -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Símbolos Asignados -->
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Símbolo</th>
                        <th>Estado</th>
                        <th>Asignado el</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var symbol in Model)
                    {
                        <tr>
                            <td>@symbol.Id</td>
                            <td>@(symbol.User?.FullName ?? "N/A")</td>
                            <td><span class="badge bg-info">@symbol.SymbolStr</span></td>
                            <td>
                                @if (symbol.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Inactivo</span>
                                }
                            </td>
                            <td>@symbol.AssignedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Edit", "Usuarios", new { id = symbol.Id })" class="btn btn-sm btn-warning">Editar</a>
                                <form method="post" action="@Url.Action("Delete", "Usuarios", new { id = symbol.Id })" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Estás seguro?')">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Sin asignaciones registradas</h4>
            <p>No hay símbolos asignados. <a href="@Url.Action("Create", "Usuarios")">Crea la primera asignación aquí</a>.</p>
        </div>
    }
</div>
