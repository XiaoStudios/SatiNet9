@model Sati_Models.DTOs.UserSymbolDto

@{
    ViewData["Title"] = "Asignar Símbolo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <h1 class="mb-4">Asignar Símbolo a Usuario</h1>

            <form method="post" asp-action="Create" asp-controller="Usuarios">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Usuario -->
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label">Usuario Admin</label>
                    <select asp-for="UserId" class="form-select" asp-items="@(ViewBag.Usuarios as SelectList)">
                        <option value="">-- Selecciona un usuario --</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <!-- Símbolo -->
                <div class="mb-3">
                    <label asp-for="SymbolStr" class="form-label">Símbolo</label>
                    <select asp-for="SymbolStr" class="form-select" asp-items="@(new SelectList(ViewBag.Simbolos))">
                        <option value="">-- Selecciona un símbolo --</option>
                    </select>
                    <span asp-validation-for="SymbolStr" class="text-danger"></span>
                </div>

                <!-- Estado Activo -->
                <div class="mb-3 form-check">
                    <input asp-for="IsActive" type="checkbox" class="form-check-input" id="activoCheckbox" />
                    <label class="form-check-label" for="activoCheckbox">
                        Símbolo Activo
                    </label>
                </div>

                <!-- Botones -->
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <a href="@Url.Action("Index", "Usuarios")" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Asignación</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
