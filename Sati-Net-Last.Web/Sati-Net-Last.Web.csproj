<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sati_Net_Last.Web</RootNamespace>
    <!-- Desactivar compresión de StaticWebAssets en desarrollo (bug .NET 9 con dotnet watch) -->
    <EnableStaticWebAssetsBuildCompression>false</EnableStaticWebAssetsBuildCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sati-Models\Sati-Models.csproj" />
  </ItemGroup>

</Project>
